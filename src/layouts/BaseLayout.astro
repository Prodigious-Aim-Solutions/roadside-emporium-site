---
// Shared header (roadside-emporium-site#3) — structural port of the live
// WordPress site's header: wordmark linking home, Facebook/Instagram
// icons, a Blog link, and the "Click Here To Start Using..." CTA —
// pointed at beta.theroadsideemporium.com per explicit direction, not the
// alpha.theroadsideemporium.com the live WordPress site's own header
// still links to.
//
// Themed to match the app's "Weathered Wood" brand (roadside-emporium-
// site#9, see src/styles/global.css) — not the old WordPress theme's own
// CSS (`wp-content/themes/roadsideemporium/style.css`), which was never
// ported and never will be now that #9 has landed.
//
// The dead Mailchimp signup embed from the live site is NOT ported —
// it was already commented out/non-functional there (confirmed directly),
// so porting it would just be copying dead code. No footer either — the
// live site genuinely has none (also confirmed directly, see knolocal#298).
//
// Font Awesome is included for the Facebook/Instagram <i class="fab
// fa-*"> icons — without it they render as nothing at all.
//
// Google Analytics (roadside-emporium-site#4) — ported verbatim from the
// live WordPress site's own gtag snippet, same G-PWL36J9WDS property, so
// historical data stays in one property across the cutover rather than
// fragmenting into a second one. Loads unconditionally on every
// environment (including local dev and GH Pages staging), matching how
// the live site itself has always loaded it — #4's own acceptance
// criteria is confirming it fires on staging before the production
// cutover, not gating it by environment.
import '../styles/global.css';

const GA_MEASUREMENT_ID = 'G-PWL36J9WDS';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', GA_MEASUREMENT_ID);
    </script>
  </head>
  <body>
    <div class="social-links">
      <a href="https://www.facebook.com/theroadsideemporium"><i class="fab fa-facebook"></i></a>
      <a href="https://www.instagram.com/theroadsideemporium"><i class="fab fa-instagram"></i></a>
      <a href={`${base}blog`}>Blog</a>
    </div>
    <div class="top-section">
      <h1><a href={base}>The Roadside Emporium</a></h1>
      <h2><a href="https://beta.theroadsideemporium.com/">Click Here To Start Using The Roadside Emporium Today!</a></h2>
    </div>
    <slot />
  </body>
</html>
