import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="For Roadside Stand Vendors | The Roadside Emporium">
  <div class="benefits-individual-section">
    <div class="benefits-individual-item">
      <h3>Expand Your Customer Base</h3>
      <p>Reach a larger audience and attract new customers to your roadside stand. Our platform allows you to promote your business to a wider community of potential buyers, increasing your chances of making more sales and establishing long-term customer relationships.</p>
    </div>
    <div class="benefits-individual-item">
      <h3>Increase Sales</h3>
      <p>Boost your sales revenue by connecting with potential buyers who are actively seeking unique products at roadside stands. Showcase your offerings, share the stories behind your creations, and captivate customers with your distinctive products and services.</p>
    </div>
    <div class="benefits-individual-item">
      <h3>Enhance Online Visibility</h3>
      <p>Get noticed by a wider audience and increase your online presence and visibility. With our platform, you can showcase your products, receive customer reviews and ratings, and establish a strong online reputation that helps drive more traffic to your roadside stand.</p>
    </div>
    <div class="benefits-individual-item">
      <h3>Build Customer Relationships</h3>
      <p>Engage directly with your customers, build relationships, and receive valuable feedback to improve your offerings. Our platform allows you to interact with customers, answer their questions, and build trust, fostering long-term loyalty and repeat business.</p>
    </div>
  </div>
</BaseLayout>
