---
// Real archive (37 posts) comes from roadside-emporium-site#2's content
// migration — the live WordPress /blog page was only ever a static
// "latest 5" block, not a real paginated archive; this one actually is.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Blog | The Roadside Emporium">
  <div class="page-content">
    <h1>Blog</h1>
    <ul class="blog-index-list">
      {posts.map((post) => (
        <li>
          {/* roadside-emporium-site#5 — BASE_URL is '/' in production,
              '/roadside-emporium-site/' on GH Pages staging; internal links
              have to be prefixed with it explicitly, since Astro's `base`
              config only rewrites asset URLs it generates itself, never a
              raw string href written by hand. */}
          <a href={`${import.meta.env.BASE_URL}blog/${post.id}/`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
